{
  "name": "krino",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  "postCreateCommand": "chmod +x scripts/*.sh && scripts/setup_linux.sh",
  "customizations": { "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter"] } },
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin" }
}
